# Database used by the local development stack
DATABASE_URL=postgres://app:local_password@localhost:5432/appointments

# Optional: run the acceptance tests against an existing database instead of
# the ephemeral one created by testcontainers.
# TEST_DATABASE_URL=postgres://app:local_password@localhost:5432/appointments_test

# API server
PORT=3000

# Lambda invocation
AWS_REGION=us-east-1
LAMBDA_FUNCTION_NAME=appointments
LAMBDA_ENDPOINT=http://localhost:3001

# Local Lambda runtime
LOCAL_LAMBDA_PORT=3001

# Business rules
SLOT_DURATION_MINUTES=60
