{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "paths": {
      "@api/*": [
        "./src/api/*"
      ],
      "@contracts/*": [
        "./src/contracts/*"
      ],
      "@lambda/*": [
        "./src/lambda/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts"
  ]
}
