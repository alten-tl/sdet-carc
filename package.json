{
  "name": "alten",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "@scarf/scarf",
      "aws-sdk",
      "cpu-features",
      "es5-ext",
      "esbuild",
      "protobufjs",
      "serverless",
      "ssh2"
    ]
  },
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "db:migrate": "tsx src/tools/migrate.ts",
    "db:revert": "tsx src/tools/migrate.ts --revert",
    "db:seed": "tsx src/tools/seed.ts",
    "local:lambda": "tsx src/tools/local-lambda.ts",
    "lint": "oxlint --type-aware src/ test/ && tsx src/tools/check-boundaries.ts",
    "lint:oxlint": "oxlint --type-aware src/ test/",
    "lint:boundaries": "tsx src/tools/check-boundaries.ts",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:bdd": "cucumber-js",
    "test:bdd:domain": "cucumber-js features/domain",
    "test:bdd:acceptance": "cucumber-js features/appointments"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1172.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.1.2",
    "@scalar/nestjs-api-reference": "^1.2.39",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "jest": "^30.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "serverless": "^3.40.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "@cucumber/cucumber": "^13.3.0",
    "expect": "^30.5.2",
    "testcontainers": "^12.2.2",
    "@testcontainers/postgresql": "^12.2.2"
  }
}
